_last_reply_wav  = None   # cached audio of the last spoken reply, for "repeat please"
_last_reply_lang = None   # language that reply was actually spoken in

audio_q     = queue.Queue(maxsize=3)
# Was maxsize=3, sized for one WAV per turn (the old blocking design).
# Streaming now enqueues one chunk PER SENTENCE, so a normal 2-4
# sentence reply already uses most of that headroom — with maxsize=3,
# the "queue full -> evict oldest" logic below could drop this same
# turn's own earlier sentences (not just stale replies from a
# previous call), making the bot skip words mid-reply. Sized generously
# above what a single ~150-token reply can produce (rarely more than
# 5-6 sentences) so eviction stays reserved for actually-stale replies.
reply_q     = queue.Queue(maxsize=10)

# Every item on reply_q carries the id of the reply it belongs to. A
# streamed answer is enqueued one clip PER SENTENCE and all its clips
# share one id, so playback can tell "the rest of this same answer"
# (play back-to-back, no gap) apart from "a different reply that
# happens to be queued next" (must stay separate — otherwise the
# greeting and a following apology are heard as one run-on utterance).
_reply_id_counter = 0
_reply_id_lock    = threading.Lock()


def _next_reply_id() -> int:
    global _reply_id_counter
    with _reply_id_lock:
        _reply_id_counter += 1
        return _reply_id_counter

