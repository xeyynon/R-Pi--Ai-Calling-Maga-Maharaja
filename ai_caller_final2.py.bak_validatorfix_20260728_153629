def _energy(chunk: bytes) -> float:
    samples = array.array("h")
    samples.frombytes(chunk)
    return sum(abs(s) for s in samples) / len(samples)


def _is_speech(chunk: bytes) -> bool:
    try:
        return _vad.is_speech(chunk, SAMPLE_RATE)
    except Exception:
        return False


