"""
stt_sarvam.py

Sarvam AI speech-to-text integration — added 2026-07-30 as the third
option in a three-way STT comparison (see stt_provider.py), specifically
because Sarvam is purpose-built for Indian-language and code-switched
("Hinglish"/"Teluglish") speech, which is exactly where both Google
configs (telephony/en-IN and multilang/3-lang) have real, measured
weaknesses (see the 2026-07-30 optimization review, §3/§6).

====================================================================
IMPORTANT — THIS INTEGRATION HAS NOT BEEN VERIFIED AGAINST A LIVE
SARVAM API KEY. No credentials were available in the environment this
was written in. The request/response shape below matches Sarvam's
PUBLICLY DOCUMENTED speech-to-text REST API as of this codebase's own
knowledge, but API shapes change and this must be confirmed against
Sarvam's current docs (https://docs.sarvam.ai) and one real API call
BEFORE this is trusted on a live phone call — this is the exact same
mistake (config looked right, was never actually exercised against a
live endpoint) that broke production earlier today with Google's
phrase-hint boosting. Verify with a real key first. See the setup
instructions at the bottom of this file.
====================================================================

Sarvam's speech-to-text API is a single-shot REST endpoint (upload
audio, get a transcript back) — not a bidirectional streaming API like
Google STT v2. So unlike stt_google.py's StreamingSession, this cannot
genuinely overlap recognition with the caller still talking; it
accumulates the whole utterance's audio and makes one HTTP call at
finish(), the same shape the old (pre-streaming) Google batch
transcribe() used. This is an honest limitation, not a bug — if
Sarvam later ships a real streaming endpoint, this should be revisited.
"""

import io
import logging
import os
import queue
import threading
import time
import wave

import requests

log = logging.getLogger("stt_sarvam")

SAMPLE_RATE = 16000  # Sarvam's REST API accepts standard WAV — no
                      # narrowband workaround needed here the way
                      # Google's telephony preset required, since this
                      # is a single file upload, not a declared-rate
                      # streaming config. Uses the recorder's native
                      # 16kHz capture rate directly, unmodified.

# CONFIRM against https://docs.sarvam.ai before trusting — this is the
# publicly documented endpoint/model name as of when this was written,
# not verified against a live call.
SARVAM_API_URL = os.environ.get(
    "SARVAM_API_URL", "https://api.sarvam.ai/speech-to-text"
)
SARVAM_MODEL = os.environ.get("SARVAM_MODEL", "saarika:v2")
SARVAM_API_KEY = os.environ.get("SARVAM_API_KEY", "")

# "unknown" requests Sarvam's automatic language identification across
# its supported Indic languages — this is Sarvam's actual differentiator
# for this project's use case (code-switched Hindi/Telugu/English in one
# utterance) and is why this integration defaults to it rather than
# pinning a single language_code the way the Google presets do.
SARVAM_LANGUAGE_CODE = os.environ.get("SARVAM_LANGUAGE_CODE", "unknown")

REQUEST_TIMEOUT_SEC = 20


def _get_client():
    # No persistent client object needed for a plain REST call — kept
    # as a function (not a bare warmup() no-op) so warmup() below has
    # something real to exercise: a credentials/reachability check.
    if not SARVAM_API_KEY:
        raise RuntimeError(
            "SARVAM_API_KEY is not set. See the setup instructions at "
            "the bottom of stt_sarvam.py."
        )
    return True


def warmup():
    """
    Unlike Google's warmup() (which just constructs a gRPC channel),
    there is no free trivial call here without spending a real Sarvam
    API request. This only checks that SARVAM_API_KEY is present —
    NOT that it's valid or that the endpoint is reachable. A genuine
    end-to-end check requires a real audio sample; run this module
    directly (see __main__ block) to do that before a live call.
    """
    _get_client()
    log.info(
        f"[STT-SARVAM] Key present, model={SARVAM_MODEL}, "
        f"language_code={SARVAM_LANGUAGE_CODE}. NOT verified against "
        f"a live call yet — see stt_sarvam.py's module docstring."
    )


def _pcm_to_wav_bytes(pcm: bytes, sample_rate: int = SAMPLE_RATE) -> bytes:
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(sample_rate)
        w.writeframes(pcm)
    return buf.getvalue()


def _call_sarvam(wav_bytes: bytes) -> tuple[str, str]:
    """
    One-shot REST call. Returns (transcript, language_code), same
    contract as stt_google.py's transcribe()/StreamingSession.finish().
    "" transcript means no speech / an unrecognized response shape;
    "ERROR" language_code means the request itself failed.

    THE RESPONSE-FIELD NAMES BELOW ("transcript", "language_code") ARE
    THE PUBLICLY DOCUMENTED SHAPE AND HAVE NOT BEEN CONFIRMED AGAINST
    A LIVE RESPONSE. If this starts silently returning "" on real
    audio, check here first — the field names are the most likely
    thing to have drifted.
    """
    headers = {"api-subscription-key": SARVAM_API_KEY}
    data = {"model": SARVAM_MODEL, "language_code": SARVAM_LANGUAGE_CODE}
    files = {"file": ("utterance.wav", wav_bytes, "audio/wav")}

    try:
        t0 = time.time()
        resp = requests.post(
            SARVAM_API_URL, headers=headers, data=data, files=files,
            timeout=REQUEST_TIMEOUT_SEC,
        )
        resp.raise_for_status()
        elapsed = time.time() - t0
    except Exception as e:
        log.error(f"[STT-SARVAM] Request failed: {e}")
        return "", "ERROR"

    try:
        body = resp.json()
    except Exception as e:
        log.error(f"[STT-SARVAM] Could not parse response JSON: {e}")
        return "", "ERROR"

    transcript = (body.get("transcript") or "").strip()
    language_code = body.get("language_code") or SARVAM_LANGUAGE_CODE

    if transcript:
        log.info(f"[STT-SARVAM] '{transcript}' (lang={language_code}, {elapsed:.2f}s)")
    else:
        log.info(f"[STT-SARVAM] No speech recognized ({elapsed:.2f}s)")
    return transcript, language_code


def transcribe(pcm: bytes) -> tuple[str, str]:
    """Batch entry point, same contract as stt_google.py's transcribe()."""
    return _call_sarvam(_pcm_to_wav_bytes(pcm))


class StreamingSession:
    """
    NOT genuinely streaming (see module docstring) — presents the same
    feed()/finish() interface as stt_google.py's StreamingSession so
    ai_caller_final2.py's recorder_thread doesn't need provider-specific
    branching, but internally just buffers every fed frame and makes
    one Sarvam REST call in finish(). latest_partial is always "" —
    there is no interim result to expose, so speculative RAG (which
    reads latest_partial) gets no early signal under this provider.
    That's a real, known trade-off of picking Sarvam today, not a bug.
    """

    def __init__(self):
        self._buf = bytearray()
        self._lock = threading.Lock()
        self.latest_partial = ""  # never populated — see class docstring

    def feed(self, chunk: bytes) -> None:
        with self._lock:
            self._buf += chunk

    def finish(self) -> tuple[str, str]:
        with self._lock:
            pcm = bytes(self._buf)
        if not pcm:
            return "", ""
        return _call_sarvam(_pcm_to_wav_bytes(pcm))


def start_streaming_session() -> StreamingSession:
    return StreamingSession()


if __name__ == "__main__":
    # Quick end-to-end check against a real Sarvam API key, using one
    # of the WAV files already captured in the 2026-07-30 STT
    # diagnostic (see stt_diagnose.py) — reuses real caller audio
    # instead of needing a fresh call just to smoke-test this
    # integration. Usage:
    #   SARVAM_API_KEY=sk_... python3 stt_sarvam.py /path/to/utt.wav
    import sys

    if len(sys.argv) < 2:
        print("Usage: SARVAM_API_KEY=... python3 stt_sarvam.py <wav_file>")
        sys.exit(1)

    with open(sys.argv[1], "rb") as f:
        wav_bytes = f.read()
    warmup()
    transcript, lang = _call_sarvam(wav_bytes)
    print(f"transcript={transcript!r} language_code={lang!r}")
